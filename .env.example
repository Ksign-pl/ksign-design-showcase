# ============================================================================
# KSIGN — zmienne środowiskowe (przykład, BEZ sekretów)
# Skopiuj do .env / ustaw w panelu hostingu (Lovable Build Secrets / Vercel).
# ============================================================================

# --- Strona marketingowa: kontakt (opcjonalne, mają wartości domyślne) -------
VITE_CONTACT_EMAIL=hello@ksign.pl
VITE_CONTACT_PHONE=+48606576517
VITE_CONTACT_WHATSAPP_URL=https://wa.me/48606576517
VITE_CALENDAR_SHORT_URL=https://cal.com/ksign/15min
VITE_CALENDAR_LONG_URL=https://cal.com/ksign/30min
VITE_CONTACT_HOURS=Odpowiadam pon–pt, 9:00–17:00 (zwykle szybciej).
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_xxx

# --- Supabase (baza, auth doradców, Storage na loga) -------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key

# ============================================================================
# KSIGN DEMO GENERATOR (/doradca)
# Każda integracja jest opcjonalna w dev — brak klucza = czytelny komunikat
# w panelu doradcy zamiast udawanej wysyłki/płatności/generowania.
# ============================================================================

# --- Anthropic (generator treści demo) ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
# Model ustawiany zmienną środowiskową (domyślnie claude-opus-4-8):
ANTHROPIC_MODEL=claude-opus-4-8

# --- Resend (e-mail z linkiem do demo) ---------------------------------------
RESEND_API_KEY=re_xxx
# Nadawca — w produkcji wymaga zweryfikowanej domeny w Resend:
RESEND_FROM_EMAIL="KSIGN <demo@ksign.pl>"

# --- Stripe Checkout (aktywacja pakietu) -------------------------------------
# Klucz API — wystarczy jeden z wariantów:
#  a) bezpośrednio:
STRIPE_SECRET_KEY=sk_test_xxx
#  b) albo istniejąca integracja Lovable (gateway):
# STRIPE_SANDBOX_API_KEY=...
# STRIPE_LIVE_API_KEY=...
# LOVABLE_API_KEY=...
# PAYMENTS_ENVIRONMENT=sandbox   # wymuszenie sandbox|live (opcjonalne)

# Price ID pakietów (ID ceny `price_...` albo lookup key z panelu Stripe):
STRIPE_PRICE_ID_START=price_xxx
STRIPE_PRICE_ID_BUSINESS=price_xxx
STRIPE_PRICE_ID_PREMIUM=price_xxx
STRIPE_PRICE_ID_ECOMMERCE=price_xxx

# Webhook (checkout.session.completed -> status dema `paid`):
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_xxx
PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_xxx

# --- Google Sheets (dopisywanie leada po wysłaniu dema) ----------------------
# Konto serwisowe z dostępem "Editor" do arkusza (udostępnij arkusz na client_email).
GOOGLE_SHEETS_CLIENT_EMAIL=demo-generator@projekt.iam.gserviceaccount.com
# Klucz prywatny PKCS8; znaki nowej linii jako \n:
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=1AbC...xyz
GOOGLE_SHEETS_RANGE=Leady!A:I

# --- Publiczne demo ----------------------------------------------------------
# Bazowy adres linków demo (docelowo subdomena demo.ksing.pl).
# Bez tej zmiennej używana jest bieżąca domena aplikacji.
PUBLIC_DEMO_BASE_URL=https://demo.ksing.pl

# Sekret endpointu okresowego wygaszania POST /api/public/demos/expire:
CRON_SECRET=wygeneruj-losowy-dlugi-sekret
