# Kontakt — wszystkie zmienne są opcjonalne (mają wartości domyślne).
# Ustaw w Workspace Settings → Build Secrets (lub lokalnym .env), aby zmienić
# dane kontaktowe i linki do kalendarza bez edycji kodu.

VITE_CONTACT_EMAIL=hello@ksign.pl
VITE_CONTACT_PHONE=+48000000000
VITE_CONTACT_WHATSAPP_URL=https://wa.me/48000000000
VITE_CALENDAR_SHORT_URL=https://cal.com/ksign/15min
VITE_CALENDAR_LONG_URL=https://cal.com/ksign/30min
VITE_CONTACT_HOURS=Odpowiadam pon–pt, 9:00–17:00 (zwykle szybciej).
